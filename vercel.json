{
  "version": 2,
  "buildCommand": "npm run build --workspace=client",
  "installCommand": "npm install --legacy-peer-deps && npm rebuild esbuild",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://106.55.102.61:3002/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
