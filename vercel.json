{
  "version": 2,
  "buildCommand": "npm run build --workspace=client",
  "installCommand": "npm install --legacy-peer-deps && npm rebuild esbuild",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
